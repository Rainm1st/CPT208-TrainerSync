/* ── Google Fonts loaded in HTML head ── */

:root {
  /* Page */
  --bg: #070d18;
  --stripe: rgba(255,255,255,0.011);
  /* Surfaces */
  --s0: #0b1422;
  --s1: #101d2e;
  --s2: #162335;
  --s3: #1c2a3e;
  /* Borders */
  --bd: rgba(255,255,255,0.08);
  --bd2: rgba(255,255,255,0.14);
  /* Text */
  --tx: #e6f0fa;
  --mu: #6b8caa;
  --mu2: #3a546e;
  /* Brand */
  --brand: #4178ff;
  --brand-t: rgba(65,120,255,0.13);
  --teal: #1dc8bb;
  --teal-t: rgba(29,200,187,0.13);
  --lime: #c8f03c;
  --lime-t: rgba(200,240,60,0.13);
  /* Status */
  --green: #22c55e;   --green-t: rgba(34,197,94,0.12);
  --amber: #f59e0b;   --amber-t: rgba(245,158,11,0.12);
  --red:   #ef4444;   --red-t:   rgba(239,68,68,0.12);
  --blue:  #3b82f6;   --blue-t:  rgba(59,130,246,0.12);
  /* Coach */
  --coach: #a855f7;  --coach-t: rgba(168,85,247,0.14);
  --coach-lt: #d8b4fe;
  /* HR zones */
  --z-blue:  #3b82f6; --z-blue-bg:  rgba(59,130,246,0.08);
  --z-green: #22c55e; --z-green-bg: rgba(34,197,94,0.08);
  --z-red:   #ef4444; --z-red-bg:   rgba(239,68,68,0.09);
  /* Shadows */
  --sh:   0 8px 32px rgba(0,0,0,0.45);
  --sh-lg:0 24px 80px rgba(0,0,0,0.65);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: 'Barlow', system-ui, sans-serif;
  font-size: 14px; line-height: 1.5;
  color: var(--tx); min-height: 100vh; overflow-x: hidden;
  background:
    repeating-linear-gradient(-52deg,transparent,transparent 80px,var(--stripe) 80px,var(--stripe) 81px),
    radial-gradient(circle at 14% 22%, rgba(65,120,255,0.13) 0%, transparent 45%),
    radial-gradient(circle at 86% 78%, rgba(29,200,187,0.10) 0%, transparent 42%),
    var(--bg);
}
* { scrollbar-width: none; -ms-overflow-style: none; }
*::-webkit-scrollbar { display: none; }
button, input { font: inherit; cursor: pointer; }
input { cursor: text; }

/* ── Ambient blobs ── */
.amb { position: fixed; border-radius: 50%; filter: blur(80px); pointer-events: none; z-index: 0; }
.amb-1 { width:380px;height:380px;background:#1a3670;top:-90px;left:-90px;opacity:.35; }
.amb-2 { width:300px;height:300px;background:#0e5a50;bottom:-60px;right:-60px;opacity:.32; }
.amb-3 { width:220px;height:220px;background:#4a1d96;top:42%;right:8%;opacity:.18; }

/* ══════════════════════════════════════════
   SHELL LAYOUT
══════════════════════════════════════════ */
.demo-shell {
  position: relative; z-index: 1;
  width: min(1340px,calc(100vw - 32px));
  margin: 24px auto;
  display: grid;
  grid-template-columns: 300px 1fr;
  gap: 28px;
  align-items: start;
}

/* ══════════════════════════════════════════
   INTRO PANEL
══════════════════════════════════════════ */
.intro-panel {
  position: sticky; top: 20px;
  background: linear-gradient(148deg, #17346f 0%, #1e43a8 55%, #1a6e7a 100%);
  border: 1px solid rgba(255,255,255,0.13);
  border-radius: 22px; padding: 20px;
  box-shadow: var(--sh-lg), inset 0 1px 0 rgba(255,255,255,0.07);
  overflow: hidden;
}
.intro-panel::before {
  content:''; position:absolute; width:300px;height:300px; border-radius:50%;
  right:-130px; top:-110px; background:rgba(255,255,255,0.05); pointer-events:none;
}

.brand-logo {
  font-family: 'Barlow Condensed', sans-serif;
  font-weight: 900; font-size: 2rem;
  letter-spacing: -0.02em; line-height: 1;
  margin-bottom: 4px; position: relative; z-index: 1;
}
.brand-trainer { color: #f0f8ff; }
.brand-sync    { color: var(--lime); }

.course-lbl {
  font-family: 'Barlow', sans-serif;
  font-size: 0.7rem; font-weight: 600;
  letter-spacing: 0.07em; text-transform: uppercase;
  color: rgba(255,255,255,0.45);
  margin-bottom: 11px; position: relative; z-index:1;
}

.intro-desc {
  font-size: 0.83rem; color: rgba(255,255,255,0.78);
  line-height: 1.55; margin-bottom: 13px;
  position: relative; z-index: 1;
}

.feat-title {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 0.68rem; font-weight: 700;
  letter-spacing: 0.1em; text-transform: uppercase;
  color: rgba(255,255,255,0.4); margin-bottom: 7px;
}

.feat-list {
  list-style: none; display: flex; flex-direction: column; gap: 5px;
  margin-bottom: 16px; position: relative; z-index: 1;
}
.feat-list li {
  font-size: 0.8rem; color: rgba(255,255,255,0.82);
  padding-left: 14px; position: relative; line-height: 1.4;
}
.feat-list li::before {
  content:''; position:absolute; left:0; top:50%; transform:translateY(-50%);
  width:6px; height:6px; border-radius:50%; background:var(--lime);
}

.page-cards-row {
  display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
  position: relative; z-index: 1;
}
.page-card {
  background: rgba(255,255,255,0.09);
  border: 1px solid rgba(255,255,255,0.13);
  border-radius: 12px; padding: 10px;
}
.page-card-ttl {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 0.68rem; font-weight: 700;
  letter-spacing: 0.06em; text-transform: uppercase;
  margin-bottom: 7px;
}
.page-card.trainee .page-card-ttl { color: var(--lime); }
.page-card.coach-c .page-card-ttl { color: var(--coach-lt); }

.page-btns { display: flex; flex-wrap: wrap; gap: 4px; }
.page-btn {
  font-family: 'Barlow', sans-serif;
  font-size: 0.68rem; font-weight: 600;
  padding: 3px 8px; border-radius: 7px;
  border: 1px solid rgba(255,255,255,0.17);
  background: rgba(255,255,255,0.08);
  color: rgba(255,255,255,0.82);
  cursor: pointer; transition: all .16s; white-space: nowrap;
}
.page-btn:hover { background:rgba(255,255,255,0.18); color:#fff; }
.page-card.coach-c .page-btn {
  border-color: rgba(168,85,247,0.32);
  background: rgba(168,85,247,0.1);
}
.page-card.coach-c .page-btn:hover { background: rgba(168,85,247,0.22); }

/* ══════════════════════════════════════════
   PHONE AREA + FRAME
══════════════════════════════════════════ */
.phone-area { display:flex; justify-content:center; }

.phone-frame {
  width: 390px; height: 854px;
  border-radius: 50px;
  background: var(--s0);
  border: 1.5px solid rgba(255,255,255,0.17);
  box-shadow:
    0 0 0 7px #03070e,
    0 0 0 9px rgba(255,255,255,0.05),
    var(--sh-lg),
    0 0 100px rgba(65,120,255,0.11);
  position: relative; display: flex; flex-direction: column;
  overflow: hidden; flex-shrink: 0;
}
.phone-frame.coach-mode {
  box-shadow:
    0 0 0 7px #03070e,
    0 0 0 9px rgba(255,255,255,0.05),
    var(--sh-lg),
    0 0 100px rgba(168,85,247,0.14);
}

.phone-island {
  width: 126px; height: 34px;
  background: #020407; border-radius: 0 0 22px 22px;
  margin: 0 auto; flex-shrink: 0;
}

.phone-sbar {
  display: flex; justify-content:space-between; align-items:center;
  padding: 6px 18px 3px;
  font-family: 'Barlow', sans-serif; font-size: 11px; font-weight: 600;
  color: var(--mu); flex-shrink: 0;
}

.phone-screen {
  flex: 1; overflow: hidden; position: relative;
  display: flex; flex-direction: column;
}

/* ── Page visibility ── */
.page { display:none; flex-direction:column; flex:1; overflow:hidden; }
.page.active { display:flex; }

/* ── Scrollable content ── */
.content {
  flex:1; overflow-y:auto;
  padding: 10px 13px 78px;
  display:flex; flex-direction:column; gap:9px;
  transition: background-color .6s;
}
.content.no-pad-bot { padding-bottom: 12px; }

/* ── Bottom nav ── */
.bnav {
  display: grid;
  border-top: 1px solid var(--bd);
  background: rgba(7,13,24,0.96);
  backdrop-filter: blur(18px);
  flex-shrink: 0;
  padding-bottom: 16px;
}
.bnav-4 { grid-template-columns: repeat(4,1fr); }
.bnav-5 { grid-template-columns: repeat(5,1fr); }

.bnav-item {
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  padding: 10px 4px 3px;
  font-family: 'Barlow', sans-serif; font-size: 9px; font-weight: 600;
  color: var(--mu2); cursor: pointer; gap: 3px;
  border: 0; background: transparent; transition: color .14s;
}
.bnav-item .nav-ico { font-size: 18px; }
.bnav-item.active { color: var(--brand); }
.bnav-item.active.coach { color: var(--coach); }
.bnav-item:hover { color: var(--mu); }

/* ── Header bar ── */
.hbar {
  display:flex; align-items:center; justify-content:space-between;
  padding: 10px 15px; border-bottom: 1px solid var(--bd); flex-shrink:0;
}
.hbar-ttl {
  font-family:'Barlow Condensed',sans-serif;
  font-size:16px; font-weight:700; color:var(--tx);
}
.hbar-back {
  font-size:12px; font-weight:600; color:var(--brand);
  border:0; background:transparent; cursor:pointer;
}
.hbar-actions { display:flex; gap:9px; align-items:center; }
.hbar-icon {
  font-size:17px; cursor:pointer; position:relative;
  width:32px; height:32px; display:flex; align-items:center; justify-content:center;
}
.badge {
  position:absolute; top:-3px; right:-3px;
  background:var(--red); color:#fff;
  font-size:9px; font-weight:700; border-radius:8px; padding:1px 4px;
}

/* ── Training header (P3, no bottom nav) ── */
.train-hbar {
  padding: 9px 15px 7px;
  border-bottom: 1px solid var(--bd); flex-shrink:0;
}
.train-hbar-top { display:flex;align-items:center;justify-content:space-between;margin-bottom:2px; }
.train-hbar-sub { font-size:11px;color:var(--mu);display:flex;gap:8px;margin-top:3px; }
.train-close-btn {
  border:1px solid rgba(239,68,68,0.35); border-radius:8px;
  padding:4px 10px; font-size:12px; font-weight:700;
  background:rgba(239,68,68,0.12); color:#fca5a5; cursor:pointer;
}

/* ══════════════════════════════════════════
   PHONE COMPONENTS
══════════════════════════════════════════ */

/* Card */
.card {
  background:var(--s1); border:1px solid var(--bd);
  border-radius:14px; padding:13px;
}
.card-ttl {
  font-family:'Barlow Condensed',sans-serif;
  font-size:10px; font-weight:700;
  letter-spacing:.1em; text-transform:uppercase;
  color:var(--mu2); margin-bottom:9px;
}

/* Rows */
.row         { display:flex; align-items:center; gap:8px; }
.row-between { display:flex; align-items:center; justify-content:space-between; }

/* KPI grid */
.kpi-grid { display:grid; grid-template-columns:1fr 1fr; gap:7px; }
.kpi-box  { background:var(--s0); border-radius:10px; padding:10px 11px; display:flex; flex-direction:column; gap:3px; }
.kpi-lbl  { font-size:10px; color:var(--mu2); }
.kpi-val  { font-family:'JetBrains Mono',monospace; font-size:17px; font-weight:700; color:var(--tx); }

/* Buttons */
.btn-primary {
  border:0; border-radius:12px; padding:12px 16px;
  font-family:'Barlow Condensed',sans-serif;
  font-size:14px; font-weight:700; letter-spacing:.02em;
  background:linear-gradient(135deg,var(--brand),var(--teal));
  color:#fff; cursor:pointer; width:100%;
}
.btn-ghost {
  border:1px solid var(--bd2); border-radius:12px; padding:11px 14px;
  font-size:13px; font-weight:600;
  background:rgba(255,255,255,0.06); color:var(--tx); cursor:pointer; flex:1;
}
.btn-danger {
  border:1px solid rgba(239,68,68,0.33); border-radius:12px; padding:11px 14px;
  font-size:13px; font-weight:600;
  background:rgba(239,68,68,0.13); color:#fca5a5; cursor:pointer; flex:1;
}
.btn-coach-primary {
  border:0; border-radius:12px; padding:12px 16px;
  font-family:'Barlow Condensed',sans-serif;
  font-size:14px; font-weight:700;
  background:linear-gradient(135deg,var(--coach),#7c3aed);
  color:#fff; cursor:pointer; width:100%;
}
.btn-coach {
  border:1px solid rgba(168,85,247,0.33); border-radius:12px; padding:11px 14px;
  font-size:13px; font-weight:600;
  background:rgba(168,85,247,0.12); color:var(--coach-lt); cursor:pointer; flex:1;
}
.btn-row { display:flex; gap:8px; }

/* Inputs */
.w-input {
  border:1px solid var(--bd2); border-radius:12px; padding:11px 13px;
  background:var(--s0); color:var(--tx); font-size:13px;
  display:flex; align-items:center; gap:8px;
}
.w-input input {
  border:0; background:transparent; color:var(--tx);
  flex:1; outline:none; font-size:13px;
}
.search-input {
  border:1px solid var(--bd2); border-radius:12px; padding:10px 13px;
  background:var(--s0); color:var(--tx); font-size:13px;
  width:100%; outline:none;
}
.search-input::placeholder { color:var(--mu); }

/* Chips */
.chips { display:flex; flex-wrap:wrap; gap:5px; }
.chip {
  border:1px solid var(--bd2); border-radius:99px; padding:4px 11px;
  font-size:11px; font-weight:600; color:var(--mu);
  cursor:pointer; background:transparent; white-space:nowrap;
}
.chip.on, .chip.active {
  background:var(--brand-t); border-color:var(--brand); color:var(--brand);
}
.chip.muscle { color:var(--brand);   border-color:rgba(65,120,255,0.35); }
.chip.equip  { color:var(--amber);   border-color:rgba(245,158,11,0.35); }
.chip.move   { color:var(--teal);    border-color:rgba(29,200,187,0.35); }
.chip.lvl    { color:var(--coach);   border-color:rgba(168,85,247,0.35); }

.filter-group { display:flex; flex-wrap:wrap; gap:5px; margin-top:7px; }
.filter-chip {
  border:1px solid var(--bd2); border-radius:99px; padding:4px 11px;
  font-size:11px; font-weight:600; color:var(--mu);
  background:transparent; cursor:pointer;
}
.filter-chip.active { background:var(--brand-t); border-color:var(--brand); color:var(--brand); }

/* Avatar */
.avatar {
  border-radius:50%; display:grid; place-items:center;
  font-family:'Barlow Condensed',sans-serif; font-weight:700;
  background:linear-gradient(135deg,var(--brand-t),var(--teal-t));
  border:1px solid var(--bd2); flex-shrink:0; color:var(--tx);
}
.av-sm { width:30px;height:30px;font-size:11px; }
.av-md { width:38px;height:38px;font-size:13px; }
.av-lg { width:52px;height:52px;font-size:17px; }
.av-coach { background:linear-gradient(135deg,rgba(168,85,247,0.28),rgba(124,58,237,0.22)); }

/* List item */
.list-item {
  background:var(--s1); border:1px solid var(--bd);
  border-radius:12px; padding:11px 12px;
  color:var(--tx);
}

/* Tags */
.tag {
  display:inline-flex; align-items:center;
  padding:3px 9px; border-radius:99px; font-size:11px; font-weight:700;
  border:1px solid rgba(255,255,255,0.1); background:rgba(255,255,255,0.07);
}
.tag-green { background:var(--green-t); border-color:var(--green); color:#86efac; }
.tag-blue  { background:var(--blue-t);  border-color:var(--blue);  color:#93c5fd; }
.tag-red   { background:var(--red-t);   border-color:var(--red);   color:#fca5a5; }
.tag-amber { background:var(--amber-t); border-color:var(--amber); color:#fcd34d; }
.tag-coach { background:var(--coach-t); border-color:var(--coach); color:var(--coach-lt); }
.tag-lime  { background:var(--lime-t);  border-color:var(--lime);  color:var(--lime); }

/* Text utils */
.t-g { color:var(--green); } .t-b { color:var(--brand); }
.t-r { color:var(--red);   } .t-a { color:var(--amber); }
.t-c { color:var(--coach); } .t-l { color:var(--lime);  }
.t-m { color:var(--mu); }
.fs10{font-size:10px;} .fs11{font-size:11px;} .fs12{font-size:12px;} .fs13{font-size:13px;}
.fw6{font-weight:600;} .fw7{font-weight:700;}
.divider { height:1px; background:var(--bd); margin:2px 0; }

/* Progress bar */
.prog-bar  { height:5px; background:var(--s3); border-radius:99px; overflow:hidden; margin-top:4px; }
.prog-fill { height:100%; border-radius:99px; background:linear-gradient(90deg,var(--brand),var(--teal)); }

/* Annotation strip */
.annot {
  border-left:2px solid var(--brand); border-radius:0 8px 8px 0;
  padding:7px 10px; font-size:11px; color:var(--mu); line-height:1.5;
  background:rgba(65,120,255,0.06);
}
.annot.green { border-left-color:var(--green); background:rgba(34,197,94,0.06); }
.annot.amber { border-left-color:var(--amber); background:rgba(245,158,11,0.06); }
.annot.red   { border-left-color:var(--red);   background:rgba(239,68,68,0.06); }

/* Section label */
.label-sm { font-size:10px; color:var(--mu2); margin-bottom:4px; }

/* ══════════════════════════════════════════
   P0: LOGIN
══════════════════════════════════════════ */
.login-logo-wrap { text-align:center; padding:36px 0 20px; }
.login-logo-icon {
  width:68px; height:68px; border-radius:20px;
  background:linear-gradient(135deg,var(--brand),var(--teal));
  display:grid; place-items:center; font-size:28px; margin:0 auto 12px;
}
.login-logo-name {
  font-family:'Barlow Condensed',sans-serif;
  font-size:24px; font-weight:900; letter-spacing:-.02em; color:var(--tx);
}
.login-logo-sub { font-size:12px; color:var(--mu); margin-top:3px; }
.divider-or {
  text-align:center; font-size:11px; color:var(--mu2); position:relative;
}
.divider-or::before,.divider-or::after {
  content:''; position:absolute; top:50%; width:35%; height:1px;
  background:var(--bd);
}
.divider-or::before { left:0; } .divider-or::after { right:0; }

/* ══════════════════════════════════════════
   P3: TRAINING / HR SIMULATOR
══════════════════════════════════════════ */

/* HR Ring */
.hr-ring-wrap { display:flex; align-items:center; gap:12px; }
.hr-ring {
  width:78px; height:78px; border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  position:relative; flex-shrink:0;
  padding:7px;
  transition:background .5s;
  background: conic-gradient(var(--z-green) 0 70%, var(--s3) 70% 100%);
}
.hr-ring::before {
  content:''; position:absolute; inset:6px; border-radius:50%;
  background:var(--s1); z-index:0;
}
.hr-ring-num {
  position:relative; z-index:1;
  font-family:'JetBrains Mono',monospace;
  font-size:19px; font-weight:700;
  transition:color .4s;
  color:var(--z-green);
}

.hr-zone-lbl { font-size:11px; font-weight:700; transition:color .4s; color:var(--z-green); margin-top:2px; }
.hr-bpm-lbl  { font-size:10px; color:var(--mu2); }

.zone-legend { display:flex; flex-wrap:wrap; gap:6px; margin-bottom:6px; }
.zone-pip { font-size:10px; color:var(--mu); display:flex; align-items:center; gap:3px; }
.zone-dot { width:7px;height:7px;border-radius:50%;display:inline-block; }

.hr-mini-chart {
  height:40px; border-radius:8px;
  background:var(--s0); border:1px solid var(--bd);
  display:flex; align-items:center; justify-content:center;
  font-size:10px; color:var(--mu2); margin-top:8px;
}

/* Set dots */
.set-dots { display:flex; gap:5px; align-items:center; }
.sdot {
  width:10px; height:10px; border-radius:50%;
  background:var(--s3); border:1.5px solid var(--bd2);
}
.sdot.done { background:var(--z-green); border-color:var(--z-green); }
.sdot.cur  { background:transparent; border:2px solid var(--z-green); box-shadow:0 0 6px rgba(34,197,94,0.5); }

/* Rest timer circle */
.c-timer {
  width:70px; height:70px; border-radius:50%;
  border:4px solid var(--s3);
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  position:relative; flex-shrink:0;
}
.c-timer::before {
  content:''; position:absolute; inset:-4px; border-radius:50%;
  border:4px solid transparent;
  border-top-color:var(--brand); border-right-color:var(--brand);
  transform:rotate(45deg);
}
.c-timer-val  { font-family:'JetBrains Mono',monospace; font-size:15px; font-weight:700; color:var(--brand); position:relative;z-index:1; }
.c-timer-lbl  { font-size:9px; color:var(--mu2); position:relative;z-index:1; }

/* Speed slider */
.w-slider { display:flex;align-items:center;gap:8px;font-size:10px;color:var(--mu); }
.slider-track { flex:1;height:4px;background:var(--s3);border-radius:2px;position:relative; }
.slider-thumb { position:absolute;top:-5px;left:52%;width:14px;height:14px;border-radius:50%;background:var(--brand);border:2px solid var(--s0); }

/* Breathing bg */
@keyframes bth-g { 0%,100%{background-color:rgba(34,197,94,0.04)} 50%{background-color:rgba(34,197,94,0.10)} }
@keyframes bth-b { 0%,100%{background-color:rgba(59,130,246,0.04)} 50%{background-color:rgba(59,130,246,0.10)} }
@keyframes bth-r { 0%,100%{background-color:rgba(239,68,68,0.04)} 50%{background-color:rgba(239,68,68,0.10)} }

.bth-green { animation:bth-g 3s ease-in-out infinite; }
.bth-blue  { animation:bth-b 2s ease-in-out infinite; }
.bth-red   { animation:bth-r 4s ease-in-out infinite; }

/* Interaction buttons (buddy dock) */
.int-btns { display:flex; gap:5px; }
.int-btn {
  width:29px;height:29px;border-radius:50%;
  border:1px solid var(--bd2); background:var(--s2);
  display:flex;align-items:center;justify-content:center;
  font-size:12px; cursor:pointer;
}

/* Emoji grid */
.emoji-grid   { display:grid; grid-template-columns:repeat(5,1fr); gap:5px; }
.emoji-grid-6 { display:grid; grid-template-columns:repeat(6,1fr); gap:4px; }
.emoji-cell {
  border:1px solid var(--bd); border-radius:8px; height:37px;
  display:flex;align-items:center;justify-content:center;
  font-size:16px; cursor:pointer; transition:background .14s;
}
.emoji-cell:hover { background:var(--s2); }

/* Cheer/action 2-col grid */
.cheer-grid { display:grid; grid-template-columns:1fr 1fr; gap:6px; }
.cheer-btn {
  border:1px solid var(--bd2); border-radius:10px;
  padding:10px 7px; font-size:12px; font-weight:600;
  background:var(--s2); color:var(--tx); cursor:pointer; text-align:center;
}
.cheer-btn.coach-c {
  border-color:rgba(168,85,247,0.3); background:rgba(168,85,247,0.1); color:var(--coach-lt);
}

/* ══════════════════════════════════════════
   P2: EXERCISE LIBRARY
══════════════════════════════════════════ */
.exercise-grid { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
.exercise-card {
  border:1px solid var(--bd); border-radius:12px;
  overflow:hidden; background:var(--s1);
  cursor:pointer; text-align:left; color:var(--tx);
  transition:border-color .18s;
}
.exercise-card.active { border-color:var(--brand); box-shadow:0 0 0 1px var(--brand-t) inset; }
.exercise-visual {
  height:84px; display:grid; place-items:center;
  background:linear-gradient(145deg,var(--brand-t),var(--teal-t));
  overflow:hidden; position:relative;
}
.exercise-visual img { width:100%;height:100%;object-fit:cover; }
.visual-fallback { font-size:10px;font-weight:700;color:var(--tx);text-align:center;padding:0 6px; }
.visual-fallback.hidden { display:none; }
.exercise-copy { padding:9px; }
.exercise-copy h4 { font-size:12px;font-weight:700;margin-bottom:3px; }
.exercise-copy p  { font-size:10px;color:var(--mu);margin:0; }
.exercise-tags { display:flex;flex-wrap:wrap;gap:3px;margin-top:6px; }
.exercise-tags span { padding:2px 6px;border-radius:99px;background:var(--s2);color:var(--mu);font-size:9px; }

/* Exercise detail panel */
.detail-preview { display:flex;gap:12px;align-items:center;margin-bottom:11px; }
.detail-visual {
  width:96px;height:96px;border-radius:12px;
  background:linear-gradient(145deg,var(--brand-t),var(--teal-t));
  display:grid;place-items:center;overflow:hidden;position:relative;flex-shrink:0;
}
.detail-visual img { width:100%;height:100%;object-fit:cover; }
.detail-gif-tip {
  position:absolute;right:4px;bottom:4px;
  font-size:9px;border-radius:99px;padding:2px 5px;
  background:rgba(0,0,0,0.6);border:1px solid rgba(255,255,255,0.2);
}
.detail-block { margin-bottom:10px; }
.detail-block h4 { font-size:12px;font-weight:700;margin-bottom:4px; }

/* ══════════════════════════════════════════
   P5a MAP + BUDDY
══════════════════════════════════════════ */
.gym-map-container {
  position:relative;width:100%;border-radius:12px;
  overflow:hidden;background:var(--s0);border:1px solid var(--bd);
}
.gym-map-img { display:block;width:100%;height:auto;min-height:158px;object-fit:cover; }
.gym-dynamic-layer { position:absolute;inset:0;pointer-events:none; }
.gym-equip-label   { position:absolute;inset:0;pointer-events:none; }
.gym-trainee-dot {
  position:absolute;width:20px;height:20px;border-radius:50%;
  transform:translate(-50%,-50%);border:2px solid;
  display:flex;align-items:center;justify-content:center;
  font-size:9px;font-weight:800;color:#fff;
}
.gym-dot-label {
  position:absolute;transform:translate(-50%,-100%);
  background:var(--s1);border:1px solid;border-radius:5px;
  padding:2px 6px;font-size:9px;font-weight:700;white-space:nowrap;
}
.map-trainee-item {
  display:flex;align-items:center;gap:9px;
  padding:8px 10px;border-radius:10px;
  background:var(--s2);margin-bottom:5px;
}
.map-trainee-avatar {
  width:28px;height:28px;border-radius:50%;
  display:grid;place-items:center;font-size:10px;font-weight:800;
  border:1.5px solid;flex-shrink:0;
}
.map-trainee-info { flex:1;min-width:0; }
.map-trainee-info strong { font-size:12px;display:block; }
.map-trainee-info span  { font-size:10px;color:var(--mu);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block; }
.map-trainee-hr { font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:700; }
.map-trainee-hr.ok    { color:var(--z-green); }
.map-trainee-hr.alert { color:var(--z-red); }
.you-tag {
  display:inline-block;padding:1px 5px;border-radius:99px;
  background:var(--brand-t);color:var(--brand);
  font-size:9px;font-weight:700;border:1px solid var(--brand);margin-left:4px;
}

/* Tab row */
.tab-row { display:flex;background:var(--s0);border-radius:10px;padding:3px;gap:2px; }
.tab-pill {
  flex:1;text-align:center;padding:7px;
  border-radius:8px;font-size:11px;font-weight:600;
  color:var(--mu);cursor:pointer;border:0;background:transparent;
}
.tab-pill.active { background:var(--s2);color:var(--tx); }

/* ══════════════════════════════════════════
   P4: SUMMARY CHARTS
══════════════════════════════════════════ */
.chart-bars { height:90px;display:flex;align-items:flex-end;gap:5px;margin-top:8px; }
.chart-bars span {
  flex:1;border-radius:5px 5px 3px 3px;opacity:.85;
  background:linear-gradient(180deg,var(--teal),var(--brand));
}
.legend-row { display:flex;gap:11px;flex-wrap:wrap;color:var(--mu);margin-top:8px;font-size:11px; }
.leg-dot { display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:4px; }

/* ══════════════════════════════════════════
   P8 PROFILE STATS
══════════════════════════════════════════ */
.profile-stats { display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:12px 0; }
.pstat { text-align:center; }
.pstat strong { font-family:'JetBrains Mono',monospace;font-size:17px;font-weight:700;display:block; }
.pstat span { font-size:10px;color:var(--mu); }

/* ══════════════════════════════════════════
   CHAT
══════════════════════════════════════════ */
.chat-stack { display:flex;flex-direction:column;gap:8px; }
.bubble-right {
  background:var(--brand);color:#fff;
  border-radius:14px 14px 4px 14px;
  padding:9px 12px;font-size:12px;align-self:flex-end;max-width:230px;
}
.bubble-left {
  background:var(--s2);border:1px solid var(--bd2);
  border-radius:14px 14px 14px 4px;
  padding:9px 12px;font-size:12px;max-width:230px;
}
.bubble-coach {
  background:rgba(168,85,247,0.16);border:1px solid rgba(168,85,247,0.28);
  border-radius:14px 14px 14px 4px;
  padding:9px 12px;font-size:12px;max-width:230px;
}
.bubble-time { font-size:9px;color:var(--mu2);margin-top:3px; }
.chat-input-row { display:flex;gap:8px;margin-top:10px; }
.chat-input-row input {
  flex:1;border:1px solid var(--bd2);border-radius:12px;
  background:var(--s0);color:var(--tx);padding:9px 12px;font-size:12px;outline:none;
}
.chat-input-row input::placeholder { color:var(--mu); }
.chat-send-btn {
  border:0;border-radius:12px;padding:9px 14px;
  font-size:12px;font-weight:700;
  background:linear-gradient(135deg,var(--coach),#7c3aed);
  color:#fff;cursor:pointer;
}

/* ══════════════════════════════════════════
   TOAST + EMOJI BURST
══════════════════════════════════════════ */
.toast {
  position:absolute;left:50%;top:68px;
  transform:translateX(-50%) translateY(-10px);
  opacity:0;min-width:230px;max-width:calc(100% - 24px);
  padding:11px 15px;border-radius:13px;
  background:rgba(7,13,24,0.97);border:1px solid rgba(65,120,255,0.42);
  color:var(--tx);text-align:center;font-size:12px;font-weight:600;
  box-shadow:var(--sh);transition:.24s ease;z-index:20;
}
.toast.show { transform:translateX(-50%) translateY(0);opacity:1; }

.emoji-overlay { position:absolute;inset:0;pointer-events:none;overflow:hidden;z-index:18; }
.emoji-float   { position:absolute;font-size:1.8rem;animation:floatUp 1.6s ease forwards; }
@keyframes floatUp {
  0%   { transform:translateY(24px) scale(.5);opacity:0; }
  15%  { opacity:1; }
  100% { transform:translateY(-150px) scale(1.1) rotate(14deg);opacity:0; }
}

/* ══════════════════════════════════════════
   MOBILE FLOAT PANEL
══════════════════════════════════════════ */
.float-btn {
  display: none;
  position:fixed; left:0; top:50%; transform:translateY(-50%);
  z-index:100;
  width:38px; height:50px; border-radius:0 12px 12px 0;
  background:var(--s1); border:1px solid var(--bd2); border-left:0;
  align-items:center; justify-content:center;
  font-size:19px; cursor:pointer; color:var(--tx);
  transition:background .2s, border-color .2s;
  box-shadow:4px 0 18px rgba(0,0,0,0.4);
}
.float-btn:hover { background:rgba(239,122,57,0.25); border-color:#ef7a39; }

.float-overlay {
  display:none;position:fixed;inset:0;
  background:rgba(0,0,0,0.55);z-index:190;
}
.float-overlay.open { display:block; }

.float-panel {
  display:none;
  position:fixed;left:0;top:0;bottom:0;
  width:288px;z-index:200;
  background:linear-gradient(148deg,#17346f 0%,#1e43a8 55%,#1a6e7a 100%);
  border-right:1px solid rgba(255,255,255,0.13);
  box-shadow:4px 0 40px rgba(0,0,0,0.6);
  overflow-y:auto;padding:22px 16px;
}
.float-panel.open { display:block; }
.float-close {
  border:1px solid rgba(255,255,255,0.2);background:rgba(255,255,255,0.1);
  color:#fff;border-radius:8px;padding:6px 11px;font-size:12px;font-weight:600;
  cursor:pointer;margin-bottom:14px;display:block;width:100%;text-align:left;
}

/* ══════════════════════════════════════════
   RESPONSIVE — MOBILE
══════════════════════════════════════════ */
@media (max-width:860px) {
  .demo-shell {
    grid-template-columns:1fr;
    width:100%; margin:0; gap:0;
  }
  .intro-panel  { display:none; }
  .phone-area   { padding:0; }
  .phone-frame  {
    width:100vw; height:100svh;
    border-radius:0; border:none;
    box-shadow:none;
  }
  .phone-island { display:none; }
  .phone-sbar   { padding:10px 18px 4px; }
  .float-btn    { display:flex; }
  .amb          { display:none; }
}
